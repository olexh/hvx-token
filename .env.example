BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=0x...
# Etherscan V2 key (works for BscScan): https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=...
